\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cvstyle}[2026/10/12 Production ATS-Safe Resume Stylesheet]

% Typography and Geometry Packages
\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage{mathptmx}           % Times New Roman font standard
\RequirePackage[margin=0.5in]{geometry} % Safe margin confinement
\RequirePackage{xcolor}
\RequirePackage{hyperref}
\RequirePackage{enumitem}
\RequirePackage{titlesec}

% Hyperlink Configuration
\hypersetup{
    colorlinks=true,
    linkcolor=black,
    filecolor=black,
    urlcolor=black,
    pdfborder={0 0 0}
}

% Page and Paragraph Formatting
\pagestyle{empty}
\raggedbottom
\raggedright
\setlength{\tabcolsep}{0in}

% Section Title Formatting
\titleformat{\section}{
  \vspace{-6pt}\scshape\raggedright\large\bfseries
}{}{0em}{}[\color{black}\titlerule \vspace{-4pt}]

% Itemize / Bullet Formatting for Density and ATS Parsing
\setlist[itemize]{
    leftmargin=0.18in,
    label=$\bullet$,
    itemsep=1.5pt,
    topsep=2pt,
    parsep=0pt,
    partopsep=0pt
}

% Reusable Resume Entry Macros
\newcommand{\resumeItem}[1]{
  \item\small{#1 \vspace{-1pt}}
}

\newcommand{\resumeSubheading}[4]{
  \vspace{-1pt}\item[]
    \begin{tabular*}{0.98\textwidth}[t]{l@{\extracolsep{\fill}}r}
      \textbf{#1} & \textbf{\small #2} \\
      \textit{\small#3} & \textit{\small #4} \\
    \end{tabular*}\vspace{-5pt}
}

\newcommand{\resumeProjectHeading}[2]{
    \vspace{-1pt}\item[]
    \begin{tabular*}{0.98\textwidth}[t]{l@{\extracolsep{\fill}}r}
      \textbf{#1} & \textbf{\small #2} \\
    \end{tabular*}\vspace{-5pt}
}

\newcommand{\resumeSubHeadingListStart}{\begin{itemize}[leftmargin=0.0in, label={}]}
\newcommand{\resumeSubHeadingListEnd}{\end{itemize}\vspace{-4pt}}
\newcommand{\resumeItemListStart}{\begin{itemize}}
\newcommand{\resumeItemListEnd}{\end{itemize}\vspace{-3pt}}

\endinput
